# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# Machine-unique overrides + private hosts (untracked, per-machine; wins on conflict).
# Included FIRST so it can override the shared config below (ssh is first-match-wins).
Include ~/.ssh/config.local
# Shared homelab/personal hosts (tracked in dotshell)
Include ~/.ssh/config.homelab

Host github.com
  ForwardX11 no

#### DEFAULTS
Host *
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  ForwardX11 no
  Protocol 2
  TCPKeepAlive yes
  ServerAliveInterval 120
