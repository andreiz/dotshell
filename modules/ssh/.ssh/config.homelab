# Shared/portable SSH config — tracked in dotshell, stowed onto every machine.
# Included by ~/.ssh/config AFTER ~/.ssh/config.local, so anything in the untracked,
# per-machine config.local overrides what's here (ssh is first-match-wins).

# --- Claude Code automation key selection -----------------------------------
# The 1Password SSH agent won't sign from non-GUI contexts (Claude's Bash tool,
# wezterm-mux), so for AI-agent sessions force the on-disk automation key instead
# of the human's 1P interactive-admin key. Guards:
#   $CLAUDECODE          -> only Claude Code sessions (set to 1 in every such shell),
#                           never the human's GUI/interactive sessions.
#   -r ~/.ssh/id_..._automation -> only on machines that actually hold an automation
#                           key (currently wick). Portable: inert elsewhere until that
#                           machine is provisioned its own key. Server-side `from=`
#                           pinning remains the real enforcement boundary.
# Must precede the per-host blocks below — ssh is first-match-wins for IdentityAgent.
Match host oslo,sofia,venice,minion,berry,mini-proxmox,prague,oak,truenas,qnas,homeassistant.local exec "test -n \"$CLAUDECODE\" -a -r \"$HOME/.ssh/id_claude_automation\""
  IdentityAgent none
  IdentityFile ~/.ssh/id_claude_automation
  IdentitiesOnly yes

# --- 1P interactive-admin as the default HUMAN agent (active bake, pre-Phase-2 strip) --------
# Human/GUI sessions use the 1Password SSH agent (interactive-admin key) fleet-wide, so daily SSH
# actually exercises the 1P key before ronin is stripped. The automation Match block ABOVE wins
# for Claude sessions (first-match-wins on IdentityAgent). ronin stays authorized on every host as
# the fallback. ROLLBACK: delete this block (or restore config.homelab.bak-rotate-2026-07-04) to
# return to the Keychain agent. Added 2026-07-04; folds into Phase-2 (drop this comment + the
# truenas/qnas id_ed25519 pins when ronin is stripped). Mirrors oslo's proven per-host pin below.
# The `exec test -z $CLAUDECODE` guard scopes this to HUMAN sessions only. Every host listed here is
# also in the automation block above (which wins first-match for Claude sessions), so Claude never
# lands here. If you add a host to THIS list, add it above too — otherwise Claude sessions to it fall
# through to the Keychain/ronin default (the 1P agent can't sign from a non-GUI shell).
Match host oslo,sofia,venice,minion,berry,mini-proxmox,prague,oak,truenas,qnas,homeassistant.local exec "test -z \"$CLAUDECODE\""
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# --- Hosts ------------------------------------------------------------------
Host homeassistant.local
  HostName homeassistant.local
  User root

Host truenas
  HostName truenas
  User andrei
  IdentityFile ~/.ssh/id_ed25519

Host qnas
  HostName qnas
  User admin
  IdentityFile ~/.ssh/id_ed25519

Host socks
  HostName zmievski.org
  Port 22
  User andrei
  DynamicForward 1080

Host ec2
  HostName 44.225.55.51
  User ubuntu
  IdentityFile ~/Dropbox/Common/Certificates/aws/default.pem

Host berry
  User pi

Host minion
  ForwardAgent yes

Host venice
  HostName 10.1.20.190
  User andrei
  ForwardAgent yes

Host oslo
  HostName 10.1.20.185
  User andrei
  ForwardAgent yes
  # 1Password SSH-agent trial (homelab-ci TODO #12 / security-review A5). Scoped to oslo.
  # Rollback: delete the two lines below. Old ronin key still authorized as fallback.
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
